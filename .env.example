# Variáveis de ambiente do modo API. Copie para `.env` e preencha.
# O modo Mock (offline) NÃO precisa de nenhuma destas variáveis.

# ---------------------------------------------------------------------------
# Provedor e modelo (escolha ÚNICA, vale para todos os agentes)
# ---------------------------------------------------------------------------
# LLM_PROVIDER: gemini | maritaca | openai   (default: gemini)
# LLM_MODEL:    id do modelo (default: o padrão do provedor escolhido)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Exemplos de troca — basta comentar o bloco acima e descomentar um destes:
#   LLM_PROVIDER=maritaca
#   LLM_MODEL=sabiazinho-4
#
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini

# Sobrescrita opcional POR PAPEL (hoje só o editor-chefe a usa). Útil para
# sintetizar o veredito num modelo mais forte que o dos revisores:
#   LLM_PROVIDER_EDITOR=openai
#   LLM_MODEL_EDITOR=gpt-4o

# ---------------------------------------------------------------------------
# Opção RESERVA (fallback) para falhas TEMPORÁRIAS do provedor principal
# ---------------------------------------------------------------------------
# Quando configurada, uma falha passageira do modelo principal (timeout,
# limite de requisições, erro de rede ou indisponibilidade da API) troca
# automaticamente para a reserva, em vez de interromper o pipeline. Cada troca
# aparece nos traces (eventos llm_fallback_*). Preencha também a chave de API
# do provedor reserva. Erros permanentes (chave inválida, pedido malformado)
# NÃO acionam a troca. Ver src/llm_fallback.py.
#   LLM_FALLBACK_PROVIDER=maritaca
#   LLM_FALLBACK_MODEL=sabia-3
#
# Só o modelo => mesmo provedor do principal (ex.: outro Gemini):
#   LLM_FALLBACK_MODEL=gemini-2.0-flash
#
# Também há a variante por papel (ex.: reserva própria do editor-chefe):
#   LLM_FALLBACK_PROVIDER_EDITOR=openai
#   LLM_FALLBACK_MODEL_EDITOR=gpt-4o-mini

# Structured output nativo (response_format json_schema): on | off.
# Por padrão liga no Gemini e na OpenAI e desliga na Maritaca, cujo suporte não
# é documentado. Desligado, o schema continua exigido no prompt e validado pelo
# ADK e pelo retry — ver src/model_provider.py.
#   LLM_JSON_SCHEMA=on

# ---------------------------------------------------------------------------
# Chaves de API — preencha apenas a do provedor que você vai usar
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=coloque_sua_chave_real_aqui
# MARITACA_API_KEY=coloque_sua_chave_real_aqui
# OPENAI_API_KEY=coloque_sua_chave_real_aqui

# Use a API pública do Gemini (FALSE) em vez do Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Compatibilidade: um .env antigo com apenas GOOGLE_API_KEY + GEMINI_MODEL
# (e sem nenhuma variável LLM_*) continua funcionando como antes.
# GEMINI_MODEL=gemini-2.5-flash

# Modo de execução padrão do pipeline: api | mock.
# (pode ser sobrescrito pela flag de linha de comando, ex.: `python src/pipeline.py mock`)
PIPELINE_MODE=api

# ---------------------------------------------------------------------------
# Custo por token (opcional) — sobrescreve a tabela de preços oficiais
# ---------------------------------------------------------------------------
# custo_estimado já é calculado automaticamente para os modelos que
# src/metrics/precos_modelos.py conhece (Gemini, OpenAI, Maritaca — via a
# tabela oficial do módulo e/ou litellm.model_cost, se instalado). Configure
# as DUAS variáveis abaixo só se: (a) seu provedor é um gateway/proxy de
# verdade, com preço diferente do público; ou (b) você quer testar com um
# preço hipotético. As DUAS são obrigatórias juntas — só uma configurada
# conta como "nenhuma" (custo continua vindo da resolução automática).
#   GRUPO2_PRECO_USD_MILHAO_TOKENS_ENTRADA=0.30
#   GRUPO2_PRECO_USD_MILHAO_TOKENS_SAIDA=2.50
